// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum PostType {
  NOTICE
  PROMOTION
  RESEARCH
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttachmentKind {
  ATTACHMENT
  INLINE_IMAGE
}

enum InquiryType {
  GENERAL
  PARTICIPATION
  DONATION_INTEREST
}

enum InquiryStatus {
  NEW
  REVIEWED
  ARCHIVED
}

enum UserRole {
  RESEARCHER
}

enum UserStatus {
  PENDING
  APPROVED
  DISABLED
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  postType    PostType
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]

  @@index([postType, isActive, sortOrder])
  @@map("categories")
}

model Post {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  summary     String?
  content     String
  type        PostType
  status      PostStatus @default(DRAFT)
  isPinned    Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId   Int?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  attachments PostAttachment[]

  @@index([type, status, deletedAt, isPinned, publishedAt])
  @@index([categoryId])
  @@index([authorId, status, updatedAt])
  @@map("posts")
}

model PostAttachment {
  id           String         @id @default(uuid()) @db.Uuid
  kind         AttachmentKind
  originalName String
  objectPath   String         @unique
  contentType  String
  size         Int
  altText      String?
  imageWidth   Int?
  imageHeight  Int?
  uploadedAt   DateTime?
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, kind, deletedAt, uploadedAt])
  @@map("post_attachments")
}

model Inquiry {
  id         Int           @id @default(autoincrement())
  name       String
  email      String?
  phone      String?
  type       InquiryType   @default(GENERAL)
  status     InquiryStatus @default(NEW)
  subject    String?
  message    String
  memo       String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?

  @@index([type, status, createdAt])
  @@map("inquiries")
}

model User {
  id              Int        @id @default(autoincrement())
  name            String
  email           String     @unique
  passwordHash    String
  role            UserRole   @default(RESEARCHER)
  status          UserStatus @default(PENDING)
  statusChangedAt DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  posts Post[]

  @@index([status, createdAt])
  @@map("users")
}
